<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>QuietByte</vendor>
  <vendor_url>https://github.com/quietbytehq/rabita</vendor_url>

  <action id="org.quietbyte.rabita.manage">
    <description>Connect this computer to, or disconnect it from, your organization</description>
    <message>Authentication is required to change how this computer signs in to your organization</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
