#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
set -e

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null 2>&1 || true
    fi
fi
# /var/lib/rabita is kept even on purge: it holds the backups needed to
# restore a computer's original sign-in settings.

exit 0
