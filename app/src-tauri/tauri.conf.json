{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rabita Setup",
  "identifier": "org.quietbyte.Rabita",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rabita Setup",
        "width": 800,
        "height": 560,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "backgroundColor": "#0F1730"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
